otelcol.receiver.otlp "snmp" {
   http {}
   grpc {}

   output {
     logs    = [otelcol.processor.batch.snmp.input]
   }
 }


otelcol.processor.batch "snmp" {
    output {
        logs = [otelcol.exporter.otlphttp.default.input]
    }
}

otelcol.exporter.otlphttp "default" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}